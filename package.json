{
  "name": "hostelmate",
  "version": "1.0.0",
  "description": "Hostel management platform by Nivo",
  "private": true,
  "scripts": {
    "predev": "node -e \"const {execSync}=require('child_process');const isWin=process.platform==='win32';[3000,3001].forEach(p=>{try{if(isWin){const pid=execSync('netstat -ano | findstr :'+p+' | findstr LISTENING',{encoding:'utf8'}).trim().split(/\\s+/).pop();if(pid&&pid!=='0')execSync('taskkill /F /PID '+pid)}else{execSync('fuser -k '+p+'/tcp',{stdio:'ignore'})}}catch{}});console.log('Ports cleared')\"",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "turbo": "latest"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=18"
  }
}
